<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Avalie sua experiência - CPC</title>
  <link rel="stylesheet" href="../css/avaliacao.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">
</head>

<%- include('../partials/header.ejs') %>
<body>
  <main>
        <h1>Últimas trocas</h1>
        <% if (sucesso) { %><p class="feedback feedback-success">Avaliação salva com sucesso.</p><% } %>
        <% if (erro) { %><p class="feedback feedback-error">Não foi possível salvar essa avaliação.</p><% } %>

        <section class="card-list">
            <% if (trocas.length === 0) { %>
                <p class="empty-state">Você ainda não possui trocas para avaliar.</p>
            <% } %>
            <% trocas.forEach(function(troca, index) { %>
                <form class="card" action="/avaliacao/<%= troca.id %>" method="POST">
                    <img src="<%= troca.foto || '../img/img home-2.png' %>" alt="Imagem de <%= troca.anuncioTitulo %>">
                    <section class="info">
                        <h2><%= troca.anuncioTitulo %></h2>
                        <p><%= troca.doadorNome %></p>
                        <p><%= new Date(troca.dataSolicitacao).toLocaleDateString('pt-BR') %></p>
                        <section class="rating" aria-label="Avalie de 1 a 5 estrelas">
                            <% [5, 4, 3, 2, 1].forEach(function(nota) { %>
                                <input type="radio" name="nota" value="<%= nota %>" id="troca<%= troca.id %>-nota<%= nota %>" <%= troca.avaliacaoNota === nota ? 'checked' : '' %> <%= troca.avaliacaoNota ? 'disabled' : '' %>>
                                <label for="troca<%= troca.id %>-nota<%= nota %>"><%= nota <= (troca.avaliacaoNota || 0) ? '★' : '★' %></label>
                            <% }) %>
                        </section>
                        <button class="save-rating" type="submit" title="Salvar avaliação" <%= troca.avaliacaoNota ? 'disabled' : '' %>>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
                        </button>
                        <% if (troca.avaliacaoNota) { %><small class="saved-rating">Avaliação salva: <%= troca.avaliacaoNota %>/5</small><% } %>
                    </section>
                </form>
            <% }) %>
        </section>

  </main>
</body>
<%- include('../partials/footer.ejs') %>
</html>