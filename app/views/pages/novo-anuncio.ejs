<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Novo Anúncio - CPC</title>
  <link rel="stylesheet" href="/css/login.css">
  <link rel="icon" href="../img/logo-black.png">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">
  <style>
    .form-anuncio { max-width: 480px; margin: 40px auto; padding: 32px; background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.10); }
    .form-anuncio h2 { color: #028166; margin-bottom: 24px; text-align: center; }
    .form-anuncio label { display: block; font-size: calc(13px * var(--a11y-escala, 1)); font-weight: 600; color: #302f2f; margin-bottom: 4px; margin-top: 14px; }
    .form-anuncio input, .form-anuncio select, .form-anuncio textarea {
      width: 100%; padding: 10px 14px; border: 1.5px solid #ccc; border-radius: 8px;
      font-family: Poppins, sans-serif; font-size: calc(14px * var(--a11y-escala, 1)); box-sizing: border-box; transition: border 0.2s;
    }
    .form-anuncio input:focus, .form-anuncio select:focus, .form-anuncio textarea:focus { border-color: #87B79F; outline: none; }
    .form-anuncio button[type=submit] {
      width: 100%; margin-top: 22px; padding: 13px; background: #109e57; color: #fff;
      border: none; border-radius: 10px; font-size: calc(16px * var(--a11y-escala, 1)); font-weight: 700; cursor: pointer; transition: background 0.2s;
    }
    .form-anuncio button[type=submit]:hover { background: #388e3c; }
    .msg-erro { background: #fdecea; color: #c62828; border-radius: 8px; padding: 12px; margin-bottom: 16px; font-size: calc(14px * var(--a11y-escala, 1)); }
    .msg-sucesso { background: #e8f5e9; color: #2e7d32; border-radius: 8px; padding: 12px; margin-bottom: 16px; font-size: calc(14px * var(--a11y-escala, 1)); }
    body { background: #f5f5f5; font-family: Poppins, sans-serif;
    }
    .btn-voltar:hover { text-decoration: underline; }
    .campo-imagens { margin-top: 14px; }
    .campo-imagens-preview { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
    .campo-imagens-preview img { width: 36px; height: 76px; object-fit: cover; border-radius: 8px; border: 1.5px solid #ccc; }
    .msg-erro { background: #fdecea; color: #c62828; border-radius: 8px; padding: 12px; margin-bottom: 16px; font-size: calc(14px * var(--a11y-escala, 1)); }
    .msg-sucesso { background: #e8f5e9; color: #2e7d32; border-radius: 8px; padding: 12px; margin-bottom: 16px; font-size: calc(14px * var(--a11y-escala, 1)); }
    body { background: #f5f5f5; font-family: Poppins, sans-serif; }

    @media (max-width: 480px) {
      .form-anuncio { margin: 16px auto; padding: 20px 16px; border-radius: 12px; max-width: calc(100% - 24px); }
      .campo-imagens-preview img { width: 64px; height: 64px; }
    }
  </style>
</head>

<body>

  <section class="form-anuncio">
    <button type="button" class="btn-voltar" id="btnVoltar" onclick="if (document.referrer && document.referrer.indexOf(window.location.host) !== -1) { history.back(); } else { window.location.href = '/todos'; }">
      ← Voltar
    </button>
    <h2>Cadastrar Anúncio</h2> 
    <p style="text-align:center;color:#666;font-size: calc(13px * var(--a11y-escala, 1));margin-bottom:20px">Ofereça um produto ou serviço para a comunidade</p>

    <% if (erro) { %>
      <section class="msg-erro">⚠️ <%= erro %></section>
    <% } %>
    <% if (sucesso) { %>
      <section class="msg-sucesso">✅ <%= sucesso %> <a href="/todos">Ver anúncios</a></section>
    <% } %>

    <form action="/novo-anuncio" method="POST" enctype="multipart/form-data">

      <label for="titulo">Título do anúncio *</label>
      <input type="text" id="titulo" name="titulo" placeholder="Ex: Encanador, Arroz 5kg, Berço..." value="<%= valores.titulo || '' %>" required>

      <label for="descricao">Descrição *</label>
      <textarea id="descricao" name="descricao" rows="3" placeholder="Descreva o que está oferecendo..." required><%= valores.descricao || '' %></textarea>

      <label for="tipo">Tipo *</label>
      <select id="tipo" name="tipo" required>
        <option value="">Selecione...</option>
        <option value="produto" <%= valores.tipo === 'produto' ? 'selected' : '' %>>Produto</option>
        <option value="servico" <%= valores.tipo === 'servico' ? 'selected' : '' %>>Serviço</option>
      </select>
      
      <label for="categoria">Categoria *</label>
      <select id="categoria" name="categoria" required>
        <option value="">Selecione...</option>
        <option value="profissionais" <%= valores.categoria === 'profissionais' ? 'selected' : '' %>>Profissionais</option>
        <option value="alimentos" <%= valores.categoria === 'alimentos' ? 'selected' : '' %>>Alimentação</option>
        <option value="infantil" <%= valores.categoria === 'infantil' ? 'selected' : '' %>>Infantil (Kids)</option>
      </select>

      <label for="doadorLocal">Localização</label>
      <input type="text" id="doadorLocal" name="doadorLocal" placeholder="Ex: Barueri-SP" value="<%= valores.doadorLocal || '' %>">

      <label for="whatsapp">WhatsApp para contato</label>
      <input type="tel" id="whatsapp" name="whatsapp" placeholder="Ex: +55 11 99999-9999" value="<%= valores.whatsapp || '' %>" required>
      <small style="font-size: calc(11px * var(--a11y-escala, 1));color:#888;margin-top:2px;display:block">O cliente usará este número para combinar a troca</small>

<section class="campo-imagens">
        <label for="imagens">Fotos do produto/serviço (até 3)</label>
        <input type="file" id="imagens" name="imagens" accept="image/*" multiple>
        <small style="font-size: calc(11px * var(--a11y-escala, 1));color:#888;margin-top:2px;display:block">JPG ou PNG, até 5MB cada. Elas aparecerão no carrossel da página do anúncio.</small>
        <section class="campo-imagens-preview" id="previewImagens"></section>
      </section>

      <button type="submit">Publicar Anúncio</button>
    </form>

    <p style="text-align:center;margin-top:16px;font-size: calc(13px * var(--a11y-escala, 1))"><a href="/todos" style="color:#4caf50">← Ver todos os anúncios</a></p>
  </section>

  <%- include('../partials/acessibilidade.ejs') %>
  <%- include('../partials/chat-ia.ejs') %>

  <script>
    (function () {
      var input = document.getElementById('imagens');
      var preview = document.getElementById('previewImagens');
      if (!input || !preview) return;

      input.addEventListener('change', function () {
        preview.innerHTML = '';
        var arquivos = Array.from(input.files || []);

        if (arquivos.length > 3) {
          alert('Selecione no máximo 3 imagens.');
          input.value = '';
          return;
        }

        arquivos.forEach(function (arquivo) {
          if (!arquivo.type.startsWith('image/')) return;
          var img = document.createElement('img');
          img.src = URL.createObjectURL(arquivo);
          img.alt = arquivo.name;
          preview.appendChild(img);
        });
      });
    })();
  </script>

</body>
</html>