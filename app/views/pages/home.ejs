<!-- ═══════════════════════════════════════════════
     NOSSO IMPACTO (mantido igual — já é funcional)
     ═══════════════════════════════════════════════ -->
<section class="impact">
  <section class="impact__header">
    <span class="impact__label">NOSSO IMPACTO</span>
    <h2 class="impact__title">Transformando vidas<br>em números reais</h2>
    <p class="impact__subtitle">
      Cada troca, cada doação e cada novo membro fortalece uma rede que
      combate a pobreza de dentro para fora.
    </p>
  </section>

  <section class="impact__stats">
    <section class="stat-card">
      <section class="stat-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </section>
      <section class="stat-card__value" id="stat-membros">2.200</section>
      <section class="stat-card__label">Membros ativos</section>
      <section class="stat-card__badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
          <polyline points="17 6 23 6 23 12"/>
        </svg>
        crescendo
      </section>
    </section>

    <section class="stat-card">
      <section class="stat-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="17 1 21 5 17 9"/>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
          <polyline points="7 23 3 19 7 15"/>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
        </svg>
      </section>
      <section class="stat-card__value" id="stat-trocas">2.000</section>
      <section class="stat-card__label">Trocas realizadas</section>
      <section class="stat-card__badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
          <polyline points="17 6 23 6 23 12"/>
        </svg>
        em alta
      </section>
    </section>

    <section class="stat-card">
      <section class="stat-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v12M9 9.5c0-1 1.3-2 3-2s3 1 3 2-1.3 2-3 2-3 1-3 2 1.3 2 3 2 3-1 3-2"/>
        </svg>
      </section>
      <section class="stat-card__value" id="stat-doacoes">1.200</section>
      <section class="stat-card__label">Total em doações</section>
      <section class="stat-card__badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
          <polyline points="17 6 23 6 23 12"/>
        </svg>
        acumulado
      </section>
    </section>
  </section>

  <section class="impact__bottom">
    <section class="impact-info-card">
      <h3 class="impact-info-card__title">Por que o CPC existe?</h3>

      <section class="impact-bar-item">
        <section class="impact-bar-item__header">
          <span class="impact-bar-item__name">Pobreza extrema — mundo</span>
          <span class="impact-bar-item__value">9.2%</span>
        </section>
        <section class="impact-bar-track">
          <section class="impact-bar-fill impact-bar-fill--orange" style="width: 9.2%"></section>
        </section>
      </section>

      <section class="impact-bar-item">
        <section class="impact-bar-item__header">
          <span class="impact-bar-item__name">Pobreza extrema — Brasil</span>
          <span class="impact-bar-item__value">5.8%</span>
        </section>
        <section class="impact-bar-track">
          <section class="impact-bar-fill impact-bar-fill--orange" style="width: 5.8%"></section>
        </section>
      </section>

      <section class="impact-bar-item">
        <section class="impact-bar-item__header">
          <span class="impact-bar-item__name">Meta CPC — redução local</span>
          <span class="impact-bar-item__value impact-bar-item__value--progress">em progresso</span>
        </section>
        <section class="impact-bar-track">
          <section class="impact-bar-fill impact-bar-fill--green" style="width: 48%"></section>
        </section>
      </section>

      <p class="impact-info-card__source">
        Fonte: Banco Mundial, 2024. O CPC atua em micro-comunidades urbanas de São Paulo.
      </p>
    </section>

    <section class="impact-cta-card">
      <span class="impact-cta-card__badge">FAÇA PARTE</span>
      <h3 class="impact-cta-card__title">Como funcionam os Créditos?</h3>
      <p class="impact-cta-card__text">
        Ofereça seu tempo ou talento, acumule créditos e troque por serviços ou
        produtos essenciais. Simples, justo e colaborativo.
      </p>
      <section class="impact-cta-card__actions">
        <a href="/novo-anuncio" class="impact-btn">Anunciar agora</a>
        <a href="/saibamais" class="impact-btn">Saiba mais</a>
      </section>
    </section>
  </section>
</section>

