<!DOCTYPE html>
<html lang="pt-BR" class="light conta-page">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Perfil</title>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap%22 rel="stylesheet">
  <link rel="stylesheet" href="/css/conta.css" />
</head>
<%- include('../partials/header.ejs') %>
 
<body>
  <main class="container">
    <section class="profile">
      <form class="profile-image" action="/conta/foto" method="POST" enctype="multipart/form-data">
        <label class="photo-trigger" for="fotoInput" title="Alterar foto de perfil">
          <img src="<%= usuario?.foto || '/img/img perfil-white.png' %>" alt="Foto de perfil de <%= usuario?.nome || 'usuário' %>" loading="lazy" id="fotoPerfil" />
        </label>
        <input id="fotoInput" name="foto" type="file" accept="image/jpeg,image/png,image/webp" hidden />
      </form>
      <section class="profile-header">
        <p class="profile-eyebrow">Minha conta</p>
        <h1><%= usuario?.nome || 'Usuário' %></h1>
        <p><%= usuario?.email || 'Sem e-mail cadastrado' %></p>
        <% if (usuario?.provider) { %>
          <span class="provider-label"><%= usuario.provider === 'google' ? 'Entrou com Google' : usuario.provider === 'local' ? 'Login local' : 'Entrou com ' + usuario.provider %></span>
        <% } %>
        <section class="balance-card" aria-label="Saldo de créditos">
          <span class="balance-icon material-symbols-outlined" aria-hidden="true"></span>
          <span class="balance-copy">
            <strong class="amount"><%= usuario?.creditos ?? 100 %></strong>
            <span class="balance-label">CRÉDITOS CPC</span>
          </span>
        </section>
      </section>
      <% if (locals.querySucesso) { %><p class="profile-message success">Foto atualizada com sucesso.</p><% } %>
      <% if (locals.queryErro) { %><p class="profile-message error">Não foi possível atualizar a foto. Use JPG, PNG ou WebP de até 5 MB.</p><% } %>
    </section>
 
      <!-- Bento Grid -->
      <section class="bento-grid">
        <!-- In-Progress Trades -->
        <section class="trades-section">
          <h2>Últimas Trocas</h2>
         
          <% if (meusTrocas && meusTrocas.length > 0) { %>
            <% meusTrocas.slice(0, 3).forEach(troca => { %>
              <% 
                const dataTroca = new Date(troca.dataSolicitacao);
                const dia = String(dataTroca.getDate()).padStart(2, '0');
                const mes = String(dataTroca.getMonth() + 1).padStart(2, '0');
                const ano = dataTroca.getFullYear();
                const dataFormatada = `${dia}/${mes}/${ano}`;
                const statusClasse = troca.status === 'concluida' ? 'status-concluido' : 'status-andamento';
                const statusTexto = troca.status === 'concluida' ? 'CONCLUÍDO' : 'ANDAMENTO';
              %>
              <section class="trade-card">
                <section class="trade-icon">
                  <img src="<%= troca.fotoPerfil %>" alt="Foto de perfil de <%= troca.doadorNome %>">
                </section>
                <section class="trade-info">
                  <p class="trade-type"><%= dataFormatada %></p>
                  <p class="trade-type"><%= troca.doadorNome %></p>
                  <p class="trade-name"><%= troca.anuncioTitulo %></p>
                </section>
                <section class="trade-status status-badge <%= statusClasse %>"><%= statusTexto %></section>
              </section>
            <% }) %>
          <% } else { %>
            <section style="padding: 20px; text-align: center; color: #999;">
              <p>Nenhuma troca realizada ainda</p>
            </section>
          <% } %>
        </section>
       
        <section class="trades-section">
          <h2>Ofertas Ativas</h2>
          <% if (meusAnuncios && meusAnuncios.length > 0) { %>
            <% meusAnuncios.slice(0, 3).forEach(anuncio => { %>
              <% const dataAnuncio = new Date(anuncio.dataCriacao); %>
              <section class="trade-card">
                <section class="trade-icon">
                  <img src="<%= usuario?.foto || '/img/img perfil-white.png' %>" alt="Foto de perfil de <%= usuario?.nome || anuncio.doadorNome %>">
                </section>
                <section class="trade-info">
                  <p class="trade-type"><%= dataAnuncio.toLocaleDateString('pt-BR') %></p>
                  <p class="trade-type"><%= anuncio.categoria %></p>
                  <p class="trade-name"><%= anuncio.titulo %></p>
                </section>
                <section class="trade-status status-badge status-ativa">ATIVA</section>
              </section>
            <% }) %>
          <% } else { %>
            <section style="padding: 20px; text-align: center; color: #999;">
              <p>Nenhum anúncio ativo ainda</p>
            </section>
          <% } %>
        </section>
  </main>
 
   <!-- Logout -->
    <section class="logout-section">
      <a href="/logout" class="logout-btn">Sair da Conta</a>
    </section>
 
    <%- include('../partials/footer.ejs') %>
    <script>
      (function () {
        var input = document.getElementById('fotoInput');
        var preview = document.getElementById('fotoPerfil');
        var formulario = input && input.form;
        if (!input || !preview || !formulario) return;
        input.addEventListener('change', function () {
          var arquivo = input.files && input.files[0];
          if (!arquivo) return;
          if (!arquivo.type.startsWith('image/') || arquivo.size > 5 * 1024 * 1024) {
            input.value = '';
            alert('Escolha uma imagem de até 5 MB.');
            return;
          }
          preview.src = URL.createObjectURL(arquivo);
          formulario.submit();
        });
      })();
    </script>
</body>
</html>