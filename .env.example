# Servidor
APP_PORT=3000

# Banco de Dados (usado somente quando migrar de JSON para MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=cpc

# Sessão
SESSION_SECRET=seu-secret-seguro-aqui

# Ambiente
NODE_ENV=development

# Chat com IA (assistente virtual do site)
# Crie uma chave em https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Opcional - modelo usado pelo chat (padrão: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5